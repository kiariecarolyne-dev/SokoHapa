{
  "expo": {
    "name": "SokoHapa",
    "slug": "SokoHapa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sokohapa-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sokohapa.app"
    },
    "android": {
      "package": "com.sokohapa.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F1F6EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F6EF",
          "image": "./assets/sokohapa-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16A34A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "034650d2-e1b6-49af-9572-005869db8ed9"
      }
    }
  }
}
