// SokoHapa - production Cloud Firestore security rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function orderData(orderId) {
      let p = /databases/$(database)/documents/orders/$(orderId);
      return exists(p) ? get(p).data : null;
    }

    function storeData(storeId) {
      let p = /databases/$(database)/documents/stores/$(storeId);
      return exists(p) ? get(p).data : null;
    }

    function requestData(requestId) {
      let p = /databases/$(database)/documents/deliveryRequests/$(requestId);
      return exists(p) ? get(p).data : null;
    }

    function assignmentData(orderId) {
      let p = /databases/$(database)/documents/deliveryAssignments/$(orderId);
      return exists(p) ? get(p).data : null;
    }

    function userData(userId) {
      let p = /databases/$(database)/documents/users/$(userId);
      return exists(p) ? get(p).data : null;
    }

    function isStoreOwner(storeId) {
      let s = storeData(storeId);
      return isSignedIn() &&
             s != null &&
             s.ownerUid == currentUid();
    }

    // True when a vendor profile describes a vendor who is currently entitled
    // to accept NEW marketplace orders.
    //
    // Expiration is always evaluated with server-side time (request.time),
    // never the device clock. Both the existing backend field
    // (subscriptionExpiryDate) and the alternative subscriptionExpiresAt are
    // honoured when present. NOTE: both must be Firestore Timestamps; a string
    // value cannot participate in a timestamp comparison and therefore the
    // vendor is NOT treated as entitled (fail-closed).
    function vendorEntitled(profile) {
      return profile != null &&
             profile.subscriptionStatus == 'active' &&
             (
               profile.subscriptionExpiryDate == null ||
               (
                 profile.subscriptionExpiryDate is timestamp &&
                 profile.subscriptionExpiryDate > request.time
               )
             ) &&
             (
               profile.subscriptionExpiresAt == null ||
               (
                 profile.subscriptionExpiresAt is timestamp &&
                 profile.subscriptionExpiresAt > request.time
               )
             );
    }

    function isActiveStore(storeId) {
      let s = storeData(storeId);
      return isSignedIn() &&
             s != null &&
             s.isActive == true;
    }

    // Matches the order's immutable `paymentVendor` snapshot against the
    // vendor's currently-configured M-PESA methods (users/{vendorUid}.
    // mpesaPaymentMethods). For every method the vendor HAS configured, the
    // buyer-written snapshot must agree exactly with the configured value;
    // methods the vendor has NOT configured fall back to the vendor's own
    // profile/store phone at checkout, which rules cannot verify because phone
    // normalization happens client-side. The identity.vendor.uid anchor on the
    // order still binds the whole vendor block (and thus any fallback
    // destination) to the genuine vendor account.
    //
    // NOTE: Firestore Rules functions may contain only `let` declarations
    // followed by a single `return` expression - no if/else or early returns -
    // so the consistency checks are expressed with ternaries.
    function paymentVendorSnapshotMatches(pv, vendorUid) {
      let m = userData(vendorUid) != null
        ? userData(vendorUid).mpesaPaymentMethods
        : null;
      let configured = m != null && m is map;
      let sendMoneyMatches = configured
        ? !(m.sendMoneyNumber is string &&
            m.sendMoneyNumber.size() > 0 &&
            pv.sendMoneyNumber != m.sendMoneyNumber)
        : true;
      let tillMatches = configured
        ? !(m.tillNumber is string &&
            m.tillNumber.size() > 0 &&
            pv.tillNumber != m.tillNumber)
        : true;
      return sendMoneyMatches &&
             tillMatches &&
             pv.keys().hasOnly(['sendMoneyNumber', 'tillNumber']) &&
             (pv.sendMoneyNumber == null || pv.sendMoneyNumber is string) &&
             (pv.tillNumber == null || pv.tillNumber is string);
    }

    // Ranks used to enforce that order and assignment state machines can only
    // move FORWARD (or re-save the same state, so idempotent re-writes still
    // pass). Unknown or earlier states map to 0 so a forward write from any
    // allowed starting point is never blocked, while a regression write
    // (e.g. Completed -> Preparing, Delivered -> Out for Delivery) is denied.
    function orderStatusRank(value) {
      return value == 'Completed' ? 2 :
             value == 'Out for Delivery' ? 1 : 0;
    }

    function deliveryProgressRank(value) {
      return value == 'Delivered' ? 3 :
             value == 'Picked Up' ? 2 :
             value == 'Out for Delivery' ? 1 : 0;
    }

    function parcelStatusRank(value) {
      return value == 'Delivered' ? 2 :
             value == 'Picked Up' ? 1 : 0;
    }

    // Allows a delivery partner to update an order only when:
    // 1. An assignment already exists for that driver, OR
    // 2. During the initial acceptance, the order points to a
    //    delivery request belonging to that driver.
    function driverWritesOnOrder(orderId) {
      let a = assignmentData(orderId);

      let rid = request.resource.data.deliveryRequestId != null
        ? request.resource.data.deliveryRequestId
        : resource.data.deliveryRequestId;

      let r = rid != null ? requestData(rid) : null;

      return
        (a != null && a.deliveryUid == currentUid()) ||
        (r != null &&
         r.deliveryUid == currentUid() &&
         r.orderId == orderId);
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // Users may create only their own profile.
      allow create: if isSignedIn() &&
        uid == currentUid() &&
        request.resource.data.uid == currentUid() &&
        request.resource.data.role in [
          'buyer',
          'vendor',
          'delivery'
        ] &&
        (
          request.resource.data.role != 'vendor' ||
          request.resource.data.subscriptionStatus == 'inactive' ||
          request.resource.data.subscriptionStatus == null
        ) &&
        // Registration writes exactly this field set (AuthContext.register);
        // anything else is rejected so the profile shape stays strict.
        request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'role',
          'fullName',
          'phone',
          'profilePhoto',
          'createdAt',
          'updatedAt',
          'storeName',
          'subscriptionStatus',
          'subscriptionStartDate',
          'subscriptionExpiryDate',
          'vehicleType',
          'vehiclePlateNumber'
        ]);

      // IMPORTANT:
      // Users can read:
      // - their own profile
      // - delivery partner profiles
      // - vendor profiles
      //
      // Buyers need vendor-profile access because StoreScreen loads
      // the vendor information belonging to a store.
      allow get: if isSignedIn() &&
        (
          uid == currentUid() ||
          (resource.data != null &&
           resource.data.role == 'delivery') ||
          (resource.data != null &&
           resource.data.role == 'vendor')
        );

      // Only a VENDOR may query the delivery directory. Restricting the list
      // to the vendor role prevents any other signed-in user from enumerating
      // every delivery partner's whole profile document. The only consumer is
      // the vendor's ChooseDeliveryScreen (creating a delivery request).
      allow list: if isSignedIn() &&
        resource.data != null &&
        resource.data.role == 'delivery' &&
        userData(currentUid()) != null &&
        userData(currentUid()).role == 'vendor';

      // Users can only update their own profile.
      // Only these fields may be changed.
      allow update: if isSignedIn() &&
        uid == currentUid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profilePhoto',
          'availability',
          'mpesaPaymentMethods',
          'updatedAt'
        ]) &&
        // The vendor's M-PESA payment methods are a fixed-shape map: optional
        // Send Money phone number and Buy Goods Till number, both strings.
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['mpesaPaymentMethods']) == false ||
          (
            (request.resource.data.mpesaPaymentMethods != null
              ? request.resource.data.mpesaPaymentMethods.diff(
                  resource.data.mpesaPaymentMethods != null
                    ? resource.data.mpesaPaymentMethods
                    : {}
                ).affectedKeys().hasOnly(['sendMoneyNumber', 'tillNumber'])
              : true) &&
            (
              request.resource.data.mpesaPaymentMethods == null ||
              request.resource.data.mpesaPaymentMethods.sendMoneyNumber == null ||
              request.resource.data.mpesaPaymentMethods.sendMoneyNumber is string
            ) &&
            (
              request.resource.data.mpesaPaymentMethods == null ||
              request.resource.data.mpesaPaymentMethods.tillNumber == null ||
              request.resource.data.mpesaPaymentMethods.tillNumber is string
            )
          )
        );
    }

    // ============================================================
    // DELIVERY CREDENTIALS (private National ID)
    // ============================================================
    // The delivery partner's National ID lives in its own owner-only document
    // instead of inside users/{deliveryUid}. Firestore rules cannot restrict
    // which fields of a returned document the app sees, and the delivery
    // directory query (users where role=='delivery') returns whole documents;
    // keeping National ID in users/ would therefore expose it to every
    // signed-in user. Only the partner themself can create, read, update or
    // delete their own document, and there is NO list access.

    match /deliveryCredentials/{deliveryUid} {

      allow create: if isSignedIn() &&
        deliveryUid == currentUid() &&
        request.resource.data.uid == currentUid() &&
        userData(deliveryUid).role == 'delivery' &&
        request.resource.data.nationalId is string &&
        request.resource.data.nationalId.size() > 0 &&
        request.resource.data.updatedAt is timestamp;

      allow get: if isSignedIn() &&
        deliveryUid == currentUid();

      // No directory: delivery credentials can never be enumerated.
      allow list: if false;

      allow update: if isSignedIn() &&
        deliveryUid == currentUid() &&
        userData(deliveryUid).role == 'delivery' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nationalId',
          'updatedAt'
        ]) &&
        request.resource.data.nationalId is string &&
        request.resource.data.nationalId.size() > 0 &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if isSignedIn() &&
        deliveryUid == currentUid() &&
        userData(deliveryUid).role == 'delivery';
    }

    // ============================================================
    // STORES
    // ============================================================

    match /stores/{storeId} {

      // A vendor creates only their own store.
      // storeId is the vendor UID.
      allow create: if isSignedIn() &&
        storeId == currentUid() &&
        request.resource.data.ownerUid == currentUid() &&
        request.resource.data.vendorUid == currentUid() &&
        request.resource.data.storeId == storeId &&
        request.resource.data.isActive == true &&
        request.resource.data.status in ['Open', 'Closed'] &&
        // rating is a fixed default placeholder on creation (5.0) and can
        // never be changed afterwards - no update branch permits it.
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        // Only a user whose own profile says they are a vendor may open a
        // marketplace storefront for themselves. Every signed-in user has a
        // users profile (created at registration), and the users rules do not
        // let a user change their role afterwards. The null case is tolerated
        // only for the tiny window before the vendor's own profile write fully
        // lands; buyers and delivery partners (profiles exist) are blocked.
        (
          userData(storeId) == null ||
          userData(storeId).role == 'vendor'
        );

      // A vendor can read their own store even if the store does not
      // exist yet. This is important because ensureVendorStore()
      // first performs getDoc() before creating the store.
      //
      // Buyers can read active stores.
      allow get: if isSignedIn() &&
        (
          currentUid() == storeId ||
          (
            resource.data != null &&
            resource.data.isActive == true
          )
        );

      // Buyers can list active stores.
      // Vendors can list their own store.
      // Enforced per returned document so a query can only ever return
      // active stores or stores owned by the current user.
      allow list: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.isActive == true ||
          resource.data.ownerUid == currentUid()
        );

      // Vendor can update only their own store.
      // Ownership fields cannot be changed.
      // `rating` is deliberately NOT writable: the buyer-facing rating is a
      // server-side/display value, never something a vendor may set themselves.
      allow update: if isStoreOwner(storeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'location',
          'phone',
          'profilePhoto',
          'vendorName',
          'status',
          'isActive',
          'updatedAt'
        ]) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status']) == false ||
          request.resource.data.status in ['Open', 'Closed']
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']) == false ||
          request.resource.data.isActive is bool
        );

      // Vendor can delete only their own store.
      allow delete: if isStoreOwner(storeId);
    }

    // ============================================================
    // STORE PRODUCTS
    // ============================================================

    match /stores/{storeId}/products/{productId} {

      // Buyers can read products from active stores.
      // Vendors can read their own products.
      allow get, list: if isSignedIn() &&
        (
          currentUid() == storeId ||
          isStoreOwner(storeId) ||
          isActiveStore(storeId)
        );

      // Vendor can create products only in their own store.
      // Prices and quantities must be sane non-negative numbers and the
      // availability flags must be booleans - a vendor cannot plant strings,
      // negatives or absurd magnitudes that would then be summed at checkout.
      allow create: if isStoreOwner(storeId) &&
        request.resource.data.storeId == storeId &&
        request.resource.data.productId == productId &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        (
          request.resource.data.availableQuantity == null ||
          (
            request.resource.data.availableQuantity is number &&
            request.resource.data.availableQuantity >= 0
          )
        ) &&
        (
          request.resource.data.isAvailable == null ||
          request.resource.data.isAvailable is bool
        ) &&
        (
          request.resource.data.available == null ||
          request.resource.data.available is bool
        );

      // Vendor can update only permitted product fields.
      // The same numeric/boolean bounds apply to every field that is changed.
      allow update: if isStoreOwner(storeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'price',
          'pricePerKg',
          'unit',
          'isAvailable',
          'available',
          'availableQuantity',
          'name',
          'displayName',
          'description',
          'category',
          'updatedAt'
        ]) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['price', 'pricePerKg']) == false ||
          (
            (
              request.resource.data.price == null ||
              (
                request.resource.data.price is number &&
                request.resource.data.price >= 0
              )
            ) &&
            (
              request.resource.data.pricePerKg == null ||
              (
                request.resource.data.pricePerKg is number &&
                request.resource.data.pricePerKg >= 0
              )
            )
          )
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['availableQuantity']) == false ||
          (
            request.resource.data.availableQuantity is number &&
            request.resource.data.availableQuantity >= 0
          )
        ) &&
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAvailable', 'available']) == false ||
          (
            (
              request.resource.data.isAvailable == null ||
              request.resource.data.isAvailable is bool
            ) &&
            (
              request.resource.data.available == null ||
              request.resource.data.available is bool
            )
          )
        );

      // Vendor can delete only their own products.
      allow delete: if isStoreOwner(storeId);
    }

    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      // Only the authenticated buyer can create an order, and only from a
      // vendor who is currently entitled to accept NEW orders (active
      // subscription, not expired per server-side time).
      allow create: if isSignedIn() &&
        request.resource.data.orderId == orderId &&
        request.resource.data.buyerUid == currentUid() &&
        request.resource.data.identity.buyer.uid == currentUid() &&
        request.resource.data.vendorUid is string &&
        request.resource.data.storeId is string &&
        request.resource.data.orderNumber is string &&
        request.resource.data.status == 'New' &&
        // The vendor's subscription is checked server-side at order creation.
        // Existing orders remain fully readable and processable after the
        // vendor's subscription expires; only NEW orders are gated here.
        vendorEntitled(userData(request.resource.data.vendorUid)) &&
        // Every order snapshot is where it is being delivered. The buyer
        // enters this at checkout and it can never change afterwards: no
        // update branch permits writing deliveryLocation.
        request.resource.data.deliveryLocation is map &&
        request.resource.data.deliveryLocation.address is string &&
        request.resource.data.deliveryLocation.address.size() > 0 &&
        // Every order snapshots the vendor's configured M-PESA payment
        // methods (Send Money number and/or Buy Goods Till number) at checkout
        // time. The snapshot is informational and immutable: it is never
        // compared against live data and no update branch may write it.
        request.resource.data.paymentVendor is map &&
        request.resource.data.paymentVendor.keys().hasOnly([
          'sendMoneyNumber',
          'tillNumber'
        ]) &&
        (
          request.resource.data.paymentVendor.sendMoneyNumber == null ||
          request.resource.data.paymentVendor.sendMoneyNumber is string
        ) &&
        (
          request.resource.data.paymentVendor.tillNumber == null ||
          request.resource.data.paymentVendor.tillNumber is string
        ) &&
        // The vendor block on an order can never be fabricated: identity.vendor
        // must reference the real vendor, and the paymentVendor snapshot must
        // agree with the vendor's stored M-PESA configuration wherever the
        // vendor has actually configured a method.
        request.resource.data.identity.vendor.uid == request.resource.data.vendorUid &&
        paymentVendorSnapshotMatches(request.resource.data.paymentVendor,
          request.resource.data.vendorUid) &&
        // The order starts its lifecycle in a strictly-controlled state. A
        // buyer cannot craft an order that already looks paid, reported or
        // verified, nor pre-assign a delivery flow; paymentStatus must start
        // as 'Pending' with none of the payment-report / verification fields
        // present, and the delivery fields must be untouched.
        request.resource.data.deliveryStatus == 'Awaiting Accept' &&
        request.resource.data.deliveryAccepted == false &&
        request.resource.data.paymentStatus == 'Pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        !request.resource.data.keys().hasAny([
          'paymentReported',
          'paymentReportedAt',
          'mpesaConfirmationMessage',
          'paymentVerifiedBy',
          'paymentVerifiedAt',
          'paymentVerificationMethod'
        ]);

      // Buyer can read their own orders.
      // Vendor can read orders belonging to their store.
      // Assigned delivery partner can read their order.
      allow get: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.buyerUid == currentUid() ||
          resource.data.vendorUid == currentUid() ||
          (
            assignmentData(orderId) != null &&
            assignmentData(orderId).deliveryUid == currentUid()
          )
        );

      // Buyer order list.
      // Vendor order list.
      // Enforced per returned document: only orders belonging to the current
      // user (as buyer or vendor) can be returned by any order query.
      allow list: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.buyerUid == currentUid() ||
          resource.data.vendorUid == currentUid()
        );

      // Order updates.
      allow update: if isSignedIn() &&
        resource.data != null &&
        (

          // --------------------------------------------------------
          // VENDOR ORDER UPDATES
          // --------------------------------------------------------

          (
            resource.data.vendorUid == currentUid() &&
            resource.data.paymentStatus == 'Verified' &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'deliveryStatus',
              'updatedAt'
            ]) &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['status']) == false ||
              (
                request.resource.data.status in [
                  'Preparing',
                  'Ready for Pickup'
                ] &&
                // The vendor can only move preparation around normal
                // pre-delivery states; an already-completed (or any later)
                // order can never be pushed backwards.
                resource.data.status in [
                  'New',
                  'Preparing',
                  'Ready for Pickup'
                ]
              )
            ) &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['deliveryStatus']) == false ||
              (
                request.resource.data.deliveryStatus in [
                  'Preparing Order',
                  'Parcel Ready'
                ] &&
                resource.data.deliveryStatus in [
                  'New',
                  'Awaiting Accept',
                  'Preparing Order',
                  'Parcel Ready'
                ]
              )
            )
          )

          ||

          // --------------------------------------------------------
          // DELIVERY PARTNER UPDATES
          // --------------------------------------------------------

          (
            driverWritesOnOrder(orderId) &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'deliveryStatus',
              'parcelStatus',
              'deliveryAccepted',
              'deliveryAcceptedAt',
              'assignedDeliveryPerson',
              'assignedDelivery',
              'deliveryRequestId',
              'updatedAt'
            ]) &&

            // A rider must never touch an order that has been cancelled;
            // accepting a stale delivery request must not resurrect an order
            // the buyer already cancelled.
            resource.data.status in [
              'New',
              'Preparing',
              'Ready for Pickup',
              'Out for Delivery'
            ] &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['status']) == false ||
              (
                request.resource.data.status in [
                  'Out for Delivery',
                  'Completed'
                ] &&
                orderStatusRank(request.resource.data.status) >=
                  orderStatusRank(resource.data.status)
              )
            ) &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['deliveryStatus']) == false ||
              (
                request.resource.data.deliveryStatus in [
                  'Out for Delivery',
                  'Picked Up',
                  'Delivered'
                ] &&
                deliveryProgressRank(request.resource.data.deliveryStatus) >=
                  deliveryProgressRank(resource.data.deliveryStatus)
              )
            ) &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['parcelStatus']) == false ||
              (
                request.resource.data.parcelStatus in [
                  'Picked Up',
                  'Delivered'
                ] &&
                parcelStatusRank(request.resource.data.parcelStatus) >=
                  parcelStatusRank(resource.data.parcelStatus)
              )
            ) &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['assignedDelivery']) == false ||
              (
                request.resource.data.assignedDelivery != null &&
                request.resource.data.assignedDelivery.uid == currentUid()
              )
            )
          )

          ||

          // --------------------------------------------------------
          // BUYER CANCELS THEIR OWN NEW ORDER
          // --------------------------------------------------------
          // A buyer may cancel only an order they own that is still 'New' and
          // that no delivery partner has accepted yet. Once a rider has
          // accepted, the cancellation is handled through the delivery flow
          // instead. Only cancellation bookkeeping fields may change; the
          // order can never move to any status other than 'Cancelled'.

          (
            resource.data.buyerUid == currentUid() &&
            resource.data.status == 'New' &&
            resource.data.deliveryAccepted == false &&
            request.resource.data.status == 'Cancelled' &&
            request.resource.data.deliveryStatus == 'Cancelled' &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'deliveryStatus',
              'cancelReason',
              'cancelledAt',
              'updatedAt'
            ])
          )

          ||

          // --------------------------------------------------------
          // BUYER EDITS THEIR OWN NEW ORDER
          // --------------------------------------------------------
          // A buyer may edit only an order they own that is still 'New' and
          // that stays 'New'. Only the order contents/totals may change;
          // identity, ownership, delivery and status fields are untouchable.

          (
            resource.data.buyerUid == currentUid() &&
            resource.data.status == 'New' &&
            // Once the buyer has reported their M-PESA payment the monetary
            // contents are frozen - the total the vendor is about to confirm
            // can never be silently re-quantified afterwards.
            resource.data.paymentStatus == 'Pending' &&
            request.resource.data.status == 'New' &&
            request.resource.data.items is list &&
            request.resource.data.items.size() > 0 &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'items',
              'subtotal',
              'packaging',
              'packagingFee',
              'total',
              'editedAt',
              'editCount',
              'updatedAt'
            ])
          )

          ||

          // --------------------------------------------------------
          // BUYER REPORTS DIRECT M-PESA PAYMENT
          // --------------------------------------------------------
          // The buyer reports a direct M-PESA payment made to the vendor by
          // pasting the confirmation message. Only allowed while the order is
          // still 'New'. Only the payment-report fields may change; the order
          // contents, ownership and status stay untouched. Once the vendor
          // accepts and status becomes 'Preparing', the buyer can no longer
          // change the payment report.

          (
            resource.data.buyerUid == currentUid() &&
            resource.data.status == 'New' &&
            request.resource.data.status == 'New' &&
            request.resource.data.paymentStatus == 'Reported' &&
            request.resource.data.paymentReported == true &&
            request.resource.data.paymentMethod == 'mpesa_direct' &&
            request.resource.data.mpesaConfirmationMessage is string &&
            request.resource.data.mpesaConfirmationMessage.size() > 0 &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentMethod',
              'paymentReported',
              'paymentReportedAt',
              'mpesaConfirmationMessage',
              'paymentStatus',
              'updatedAt'
            ])
          )

          ||

          // --------------------------------------------------------
          // VENDOR MANUALLY VERIFIES PAYMENT REPORT (ACCEPT)
          // --------------------------------------------------------
          // The vendor manually compared the buyer's pasted M-PESA message
          // against their actual M-PESA transaction and confirms the payment.
          // Only works while the order is still 'New' with paymentStatus
          // 'Reported', so a stale screen or a second device can never accept
          // an order that was already rejected or processed. The transition
          // moves the order into the normal vendor processing flow
          // (status 'Preparing', deliveryStatus 'Preparing Order').

          (
            resource.data.vendorUid == currentUid() &&
            resource.data.status == 'New' &&
            resource.data.paymentStatus == 'Reported' &&
            request.resource.data.status == 'Preparing' &&
            request.resource.data.deliveryStatus == 'Preparing Order' &&
            request.resource.data.paymentStatus == 'Verified' &&
            request.resource.data.paymentVerifiedBy == currentUid() &&
            request.resource.data.paymentVerificationMethod == 'vendor_manual' &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'paymentVerifiedBy',
              'paymentVerifiedAt',
              'paymentVerificationMethod',
              'status',
              'deliveryStatus',
              'updatedAt'
            ])
          )

          ||

          // --------------------------------------------------------
          // VENDOR REJECTS PAYMENT REPORT (CANCEL)
          // --------------------------------------------------------
          // The vendor could not confirm the payment and cancels the order.
          // Only works while the order is still 'New' with paymentStatus
          // 'Reported', so a rejected order can never later be accepted or
          // delivered. Buyer-side fields, totals and identity are untouched.

          (
            resource.data.vendorUid == currentUid() &&
            resource.data.status == 'New' &&
            resource.data.paymentStatus == 'Reported' &&
            request.resource.data.status == 'Cancelled' &&
            request.resource.data.deliveryStatus == 'Cancelled' &&
            request.resource.data.paymentStatus == 'Rejected' &&
            request.resource.data.cancelledBy == 'vendor' &&
            request.resource.data.cancelledByUid == currentUid() &&

            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus',
              'status',
              'deliveryStatus',
              'cancelledBy',
              'cancelledByUid',
              'cancelledAt',
              'cancelReason',
              'updatedAt'
            ])
          )
        );
    }

    // ============================================================
    // DELIVERY REQUESTS
    // ============================================================

    match /deliveryRequests/{requestId} {

      // Vendor creates a delivery request for one of their own orders.
      allow create: if isSignedIn() &&
        request.resource.data.requestId == requestId &&
        request.resource.data.orderId is string &&
        orderData(request.resource.data.orderId) != null &&
        orderData(request.resource.data.orderId).vendorUid == currentUid() &&
        // Delivery can never start until the vendor has manually verified the
        // buyer's direct M-PESA payment report AND physically prepared the
        // parcel (order status 'Ready for Pickup'). Both preconditions are
        // read from the order document, never from the request payload.
        orderData(request.resource.data.orderId).paymentStatus == 'Verified' &&
        orderData(request.resource.data.orderId).status == 'Ready for Pickup' &&
        orderData(request.resource.data.orderId).deliveryAccepted != true &&
        request.resource.data.vendorUid == currentUid() &&
        request.resource.data.deliveryUid is string &&
        request.resource.data.status == 'Awaiting Accept' &&
        // The destination on the request must be exactly the destination
        // snapshotted on the order at checkout. The vendor (or any client)
        // cannot invent or alter the delivery address.
        request.resource.data.deliveryLocation is map &&
        request.resource.data.deliveryLocation.address is string &&
        orderData(request.resource.data.orderId).deliveryLocation != null &&
        request.resource.data.deliveryLocation.address ==
          orderData(request.resource.data.orderId).deliveryLocation.address &&
        // The request snapshot is a fixed shape produced by
        // deliveryService.createDeliveryRequest; anything else is rejected.
        request.resource.data.keys().hasOnly([
          'requestId',
          'orderId',
          'orderNumber',
          'vendorUid',
          'buyerUid',
          'deliveryUid',
          'vendor',
          'buyer',
          'pickupLocation',
          'deliveryLocation',
          'distanceKm',
          'items',
          'packaging',
          'packagingFee',
          'subtotal',
          'total',
          'deliveryStatus',
          'deliveryAccepted',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      // Rider can read their own request.
      // Vendor can read requests belonging to their orders.
      allow get: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.deliveryUid == currentUid() ||
          resource.data.vendorUid == currentUid()
        );

      // Rider pending-request list.
      // Vendor request list.
      // Enforced per returned document: only requests addressed to the current
      // rider or created by the current vendor can be returned.
      allow list: if isSignedIn() &&
        resource.data != null &&
        (
          resource.data.deliveryUid == currentUid() ||
          resource.data.vendorUid == currentUid()
        );

      // Rider can accept or decline a request.
      allow update: if isSignedIn() &&
        resource.data != null &&
        resource.data.deliveryUid == currentUid() &&
        resource.data.status == 'Awaiting Accept' &&
        (

          // ACCEPT
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'deliveryAccepted',
              'acceptedAt',
              'deliveryUid',
              'updatedAt'
            ]) &&

            request.resource.data.status == 'Accepted' &&

            // A rider must never accept a request whose order was cancelled
            // (e.g. the buyer cancelled before assignment was created).
            orderData(resource.data.orderId) != null &&
            orderData(resource.data.orderId).status != 'Cancelled' &&

            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['deliveryUid']) == false ||
              request.resource.data.deliveryUid == currentUid()
            )
          )

          ||

          // DECLINE
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'declinedAt',
              'updatedAt'
            ]) &&

            request.resource.data.status == 'Declined'
          )
        );
    }

    // ============================================================
    // DELIVERY ASSIGNMENTS
    // ============================================================

    // Document ID = orderId.
    match /deliveryAssignments/{orderId} {

      // Only the delivery partner named in the delivery request
      // can create the assignment.
      allow create: if isSignedIn() &&
        request.resource.data.orderId == orderId &&
        request.resource.data.assignmentId == orderId &&
        request.resource.data.deliveryUid == currentUid() &&
        request.resource.data.requestId is string &&
        requestData(request.resource.data.requestId) != null &&
        requestData(request.resource.data.requestId).deliveryUid == currentUid() &&
        requestData(request.resource.data.requestId).orderId == orderId &&
        // An assignment can never be minted for a cancelled order (a stale
        // 'Awaiting Accept' request must not resurrect a cancelled order).
        orderData(orderId) != null &&
        orderData(orderId).status != 'Cancelled' &&
        request.resource.data.status == 'Confirmed' &&
        // The assignment inherits the order's snapshotted destination; a
        // rider cannot invent a delivery address on an assignment.
        request.resource.data.deliveryLocation is map &&
        request.resource.data.deliveryLocation.address is string &&
        orderData(orderId).deliveryLocation != null &&
        request.resource.data.deliveryLocation.address ==
          orderData(orderId).deliveryLocation.address;

      // Rider can read their own assignment.
      allow get: if isSignedIn() &&
        resource.data != null &&
        resource.data.deliveryUid == currentUid();

      // Rider active/history lists.
      // Enforced per returned document: riders only see their own assignments.
      allow list: if isSignedIn() &&
        resource.data != null &&
        resource.data.deliveryUid == currentUid();

      // Rider can update delivery progress.
      allow update: if isSignedIn() &&
        resource.data != null &&
        resource.data.deliveryUid == currentUid() &&
        // A rider can never advance (or fabricate completion on) an assignment
        // whose order has been cancelled.
        orderData(orderId) != null &&
        orderData(orderId).status != 'Cancelled' &&

        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'parcelStatus',
          'deliveryStatus',
          'status',
          'completedAt',
          'updatedAt'
        ]) &&

        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['status']) == false ||
          request.resource.data.status == 'Completed'
        ) &&

        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['deliveryStatus']) == false ||
          (
            request.resource.data.deliveryStatus in [
              'Out for Delivery',
              'Picked Up',
              'Delivered'
            ] &&
            deliveryProgressRank(request.resource.data.deliveryStatus) >=
              deliveryProgressRank(resource.data.deliveryStatus)
          )
        ) &&

        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['parcelStatus']) == false ||
          (
            request.resource.data.parcelStatus in [
              'Picked Up',
              'Delivered'
            ] &&
            parcelStatusRank(request.resource.data.parcelStatus) >=
              parcelStatusRank(resource.data.parcelStatus)
          )
        );
    }
  }
}